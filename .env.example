# Copy to .env and adjust as needed before running `docker compose up -d`.

# Hub display name shown in the mobile app
AGENTFLEET_HUB_NAME=AgentFleet Hub

# URL encoded into pairing QR codes and node join commands.
# - LAN / Tailscale: http://<your-lan-or-tailscale-ip>:8787
# - Public HTTPS (with --profile tls): https://hub.example.com
AGENTFLEET_PUBLIC_URL=

# Host port binding for direct access.
# When using `--profile tls` on a public VPS, change to `127.0.0.1:8787:8787` so only Caddy exposes 80/443.
AGENTFLEET_BIND=8787:8787

# Only required for `docker compose --profile tls up -d` (automatic Let's Encrypt HTTPS via Caddy)
AGENTFLEET_DOMAIN=

# Optional: override container image (or build locally with `docker compose up -d --build`)
# AGENTFLEET_IMAGE=ghcr.io/bigheadh/agentfleet-hub:latest

# Optional: push notifications (see docs/notifications.md)
# AGENTFLEET_EXPO_PUSH=1
# AGENTFLEET_PUSH_REDACT=0
# AGENTFLEET_NTFY_URL=https://ntfy.sh/<long-random-topic>
# AGENTFLEET_NTFY_TOKEN=
# AGENTFLEET_WEBHOOK_URL=
